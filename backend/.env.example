# ResolveAI Environment Variables
# Copy to .env and adjust as necessary

# Server configuration
PROJECT_NAME="ResolveAI"
PORT=8000
HOST="127.0.0.1"

# Google Gemma / Gemini API (Optional for live LLM extraction; mock fallback included)
GEMMA_API_KEY=""

# n8n Automation Engine Webhook URL (Optional; internal workflow engine activates if unset)
N8N_WEBHOOK_URL=""

# Hybrid Duplicate Detection Settings
SEMANTIC_SIMILARITY_THRESHOLD=0.50
HYBRID_DUPLICATE_THRESHOLD=0.58
